{
  "name": "vicebay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "test": "vitest run",
    "manus:build-source": "tsc --noEmit && vite build && node scripts/check-size.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "eslint": "^10.15.0",
    "firebase": "^13.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}