rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPosition(pos) {
      return pos is map
        && pos.keys().hasAll(['x', 'y', 'z'])
        && pos.keys().hasOnly(['x', 'y', 'z'])
        && (pos.x is int || pos.x is float) && pos.x >= -400 && pos.x <= 400
        && (pos.y is int || pos.y is float) && pos.y >= -20 && pos.y <= 80
        && (pos.z is int || pos.z is float) && pos.z >= -400 && pos.z <= 400;
    }

    function isValidInventory(inv) {
      return inv is map
        && inv.keys().hasAll(['ammo', 'armor', 'weapon', 'sprintTier'])
        && inv.keys().hasOnly(['ammo', 'armor', 'weapon', 'sprintTier'])
        && inv.ammo is int && inv.ammo >= 0 && inv.ammo <= 999
        && inv.armor is int && inv.armor >= 0 && inv.armor <= 100
        && inv.weapon is string && inv.weapon.size() >= 1 && inv.weapon.size() <= 24
        && inv.sprintTier is int && inv.sprintTier >= 0 && inv.sprintTier <= 3;
    }

    function isValidLkp(lkp) {
      return lkp is map
        && lkp.keys().hasAll(['x', 'z'])
        && lkp.keys().hasOnly(['x', 'z'])
        && (lkp.x is int || lkp.x is float) && lkp.x >= -400 && lkp.x <= 400
        && (lkp.z is int || lkp.z is float) && lkp.z >= -400 && lkp.z <= 400;
    }

    function isValidHeat(heat) {
      return heat is map
        && heat.keys().hasAll(['wanted', 'phase', 'lastKnownPos'])
        && heat.keys().hasOnly(['wanted', 'phase', 'lastKnownPos'])
        && heat.wanted is int && heat.wanted >= 0 && heat.wanted <= 6
        && heat.phase is string && heat.phase in ['clear', 'witness', 'pursuit', 'evading']
        && (heat.lastKnownPos == null || isValidLkp(heat.lastKnownPos));
    }

    function isValidPlayerSave(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'money', 'health', 'completed', 'upgrade',
          'muted', 'weather', 'robbedStores', 'seenIntro', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'money', 'health', 'completed', 'upgrade',
          'muted', 'weather', 'robbedStores', 'seenIntro',
          'position', 'inventory', 'heat', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.money is int
        && data.money >= 0
        && data.money <= 1000000000
        && (data.health is int || data.health is float)
        && data.health >= 0
        && data.health <= 100
        && data.completed is list
        && data.completed.size() <= 20
        && (data.completed.size() == 0 || (data.completed[0] is string && data.completed[0].size() >= 1 && data.completed[0].size() <= 32))
        && data.upgrade is int
        && data.upgrade >= 0
        && data.upgrade <= 3
        && data.muted is bool
        && data.weather is string
        && data.weather.size() <= 16
        && data.weather in ['day', 'sunset', 'rain', 'night']
        && data.robbedStores is list
        && data.robbedStores.size() <= 10
        && (data.robbedStores.size() == 0 || (data.robbedStores[0] is string && data.robbedStores[0].size() >= 1 && data.robbedStores[0].size() <= 32))
        && data.seenIntro is bool
        && (!('position' in data) || isValidPosition(data.position))
        && (!('inventory' in data) || isValidInventory(data.inventory))
        && (!('heat' in data) || isValidHeat(data.heat))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'contractsCompleted', 'bestDurationMs', 'lastMissionId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'contractsCompleted', 'bestDurationMs', 'lastMissionId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && data.contractsCompleted is int
        && data.contractsCompleted >= 1
        && data.contractsCompleted <= 10000
        && data.bestDurationMs is int
        && data.bestDurationMs >= 500
        && data.bestDurationMs <= 1800000
        && data.lastMissionId is string
        && data.lastMissionId.size() >= 1
        && data.lastMissionId.size() <= 32
        && data.lastMissionId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Connection health check path (non-existent doc, read-only)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Private per-user campaign save
    match /players/{userId} {
      allow get: if isVerifiedUser() && isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidPlayerSave(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidPlayerSave(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'money', 'health', 'completed', 'upgrade',
          'muted', 'weather', 'robbedStores', 'seenIntro',
          'position', 'inventory', 'heat', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Public arcade contract leaderboard (one document per verified player UID)
    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if resource.data.contractsCompleted is int && resource.data.contractsCompleted >= 1;
      allow create: if isVerifiedUser()
        && isOwner(entryId)
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isOwner(entryId)
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'contractsCompleted', 'bestDurationMs', 'lastMissionId', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
